# === Aplicação ===
EPI_ENVIRONMENT=development
EPI_API_PREFIX=/api/v1

# === Banco de dados ===
# Dev/testes (SQLite):
EPI_DATABASE_URL=sqlite+aiosqlite:///./epi_identity.db
# Produção (PostgreSQL):
# EPI_DATABASE_URL=postgresql+asyncpg://epi:senha@localhost:5432/epi

# === Segurança ===
EPI_JWT_SECRET=troque-por-um-segredo-forte
EPI_JWT_EXPIRATION_MINUTES=60
# Chave Fernet (base64, 32 bytes). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Em produção, obtenha de um KMS/HSM, não do arquivo .env.
EPI_BIOMETRIC_ENCRYPTION_KEY=

# === Reconhecimento facial ===
EPI_FACE_PROVIDER=mock            # mock | insightface
EPI_FACE_MODEL_VERSION=mock-v1
EPI_EMBEDDING_DIM=512

# === Thresholds (configuráveis) ===
EPI_QUALITY_THRESHOLD=0.60
EPI_SIMILARITY_THRESHOLD=0.55
EPI_CONFIDENCE_THRESHOLD=0.80
EPI_AMBIGUITY_MARGIN=0.05

# === Tracking / reidentificação ===
EPI_IDENTITY_TTL_SECONDS=30
EPI_TRACK_TTL_SECONDS=15
EPI_TRACKER_IOU_THRESHOLD=0.3

# === Privacidade (LGPD) ===
EPI_PERSIST_RAW_FACE_IMAGES=false
EPI_EMBEDDING_RETENTION_DAYS=365
