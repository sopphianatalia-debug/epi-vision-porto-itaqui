# === Aplicação ===
FUS_ENVIRONMENT=development
FUS_API_PREFIX=/api/v1

# === EPIs exigidos (resumo de evidência, não conformidade) ===
FUS_REQUIRED_PPE=["helmet","vest","gloves","boots"]

# === Identidade ===
FUS_IDENTITY_CONFIDENCE_THRESHOLD=0.80
FUS_IDENTITY_RESOLVER=employee_id

# === Tempo (segundos) ===
FUS_FUSION_WINDOW_SECONDS=5.0
FUS_IDENTITY_TTL_SECONDS=3.0
FUS_STATE_TTL_SECONDS=30.0

# === Conflito ===
FUS_CONFLICT_CONFIDENCE_MARGIN=0.15
