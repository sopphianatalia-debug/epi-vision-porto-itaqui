# === Aplicação ===
CMP_ENVIRONMENT=development
CMP_API_PREFIX=/api/v1

# === Análise temporal ===
CMP_TEMPORAL_WINDOW=5
CMP_TEMPORAL_MIN_FRAMES=3
CMP_HIGH_CONFIDENCE_AGREEMENT=0.8

# === Confiança ===
CMP_CONFIDENCE_THRESHOLD=0.60

# === Posicionamento / cobertura ===
CMP_HELMET_HEAD_OVERLAP_THRESHOLD=0.30
CMP_VEST_TORSO_COVERAGE_THRESHOLD=0.35
CMP_GLOVE_HAND_OVERLAP_THRESHOLD=0.15
CMP_BOOTS_FEET_OVERLAP_THRESHOLD=0.20

# === Visibilidade ===
CMP_FRAME_EDGE_MARGIN=0.01

# === Regras (quais EPIs são exigidos) ===
# JSON: ["helmet","vest","gloves","boots","glasses"]
CMP_REQUIRED_PPE=["helmet","vest","gloves","boots"]

# === Pose ===
CMP_POSE_PROVIDER=heuristic   # heuristic | yolo

# === Evidência / retenção (LGPD) ===
CMP_EVIDENCE_MAX_ENTRIES=1000
CMP_EVIDENCE_RETENTION_DAYS=90
CMP_EVIDENCE_STORE_IMAGE=false
