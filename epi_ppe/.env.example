# === Aplicação ===
PPE_ENVIRONMENT=development
PPE_API_PREFIX=/api/v1

# === Modelo de detecção (plugável) ===
PPE_DETECTOR_PROVIDER=mock          # mock | yolo
PPE_DETECTOR_MODEL_PATH=yolov8n.pt  # usado pelo provider yolo
PPE_DETECTOR_DEVICE=auto            # auto | cpu | cuda

# === Thresholds por classe (configuráveis) ===
PPE_DEFAULT_CONFIDENCE_THRESHOLD=0.40
PPE_PERSON_CONFIDENCE_THRESHOLD=0.50
PPE_HELMET_CONFIDENCE_THRESHOLD=0.45
PPE_VEST_CONFIDENCE_THRESHOLD=0.45
PPE_GLOVE_CONFIDENCE_THRESHOLD=0.40
PPE_BOOTS_CONFIDENCE_THRESHOLD=0.40
PPE_GLASSES_CONFIDENCE_THRESHOLD=0.40
PPE_EAR_CONFIDENCE_THRESHOLD=0.40
PPE_NMS_IOU_THRESHOLD=0.50

# === Associação pessoa <-> EPI ===
PPE_ASSOCIATION_CONTAINMENT_THRESHOLD=0.50
PPE_ASSOCIATION_SCORE_THRESHOLD=0.35

# === Tracking ===
PPE_TRACKER_IOU_THRESHOLD=0.30
PPE_TRACK_TTL_FRAMES=30

# === Avaliação ===
PPE_EVAL_IOU_THRESHOLD=0.50
